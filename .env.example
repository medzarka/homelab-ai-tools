# ==============================================================================
# HOMELAB AI TOOLS NODE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- 1. Host Identity & Network Configuration ---
NODE_NAME=compute-tools
ROOT_DOMAIN=example.com
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net

# --- 2. Host Workspace Storage Directory ---
# Points to the host directory for persistent or fast storage (NVMe, SSD, or host-managed mount)
WORKSPACE_DIR=/srv/data/workspace

# --- 3. Ollama Vision & Chat Models ---
OLLAMA_INIT_MODELS=qwen2.5vl:3b,hermes3:8b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=24h

# --- 4. OnlyOffice Document Server (Single-User Lean Edition) ---
# Generate a 64-character hex secret: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=replace_with_64_char_hex_jwt_secret

# --- 5. SearXNG Private Search Engine ---
# Generate a 32-character hex secret: openssl rand -hex 16
SEARXNG_SECRET=replace_with_32_char_hex_searxng_secret

# --- 6. Firecrawl Web Scraper Stack ---
FIRECRAWL_API_KEY=replace_with_secure_firecrawl_api_key

# --- 7. CPU Thread & Concurrency Tuning ---
OMP_NUM_THREADS=12
RAYON_NUM_THREADS=12
WHISPER_CPU_THREADS=8

# --- 8. API Security Keys (Securing AI Inference & Compute Services) ---
OLLAMA_API_KEY=replace_with_secure_ollama_api_key
TEI_API_KEY=replace_with_secure_tei_api_key
SPEACHES_API_KEY=replace_with_secure_speaches_api_key

# --- 9. Firecrawl Internal Database & Queue Credentials ---
NUQ_USER=nuq_user
NUQ_PASSWORD=replace_with_secure_db_password
NUQ_DB=nuq_db
RABBITMQ_ERLANG_COOKIE=replace_with_secure_erlang_cookie
