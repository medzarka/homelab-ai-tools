# ==============================================================================
# HOMELAB AI TOOLS NODE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- 1. Host Identity & Network Configuration ---
NODE_NAME=compute-tools
COMPUTE_NODE_TS_IP=100.x.y.z
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net

# --- 2. RAM-Disk Storage Pool ---
# The RAM disk is mounted natively by the host OS.
# The container simply bind-mounts this path to ensure ephemeral storage.
RAMDISK_DIR=/mnt/ramdisk

# --- 3. Ollama Vision & Chat Models ---
OLLAMA_INIT_MODELS=qwen2.5vl:3b,hermes3:8b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=24h

# --- 4. OnlyOffice Document Server (Single-User Lean Edition) ---
ONLYOFFICE_JWT_SECRET=4289cb7b0722e1b1dd47d7c6fb5b08e5c46e3ea40fa3d9cb910901e18d6e3260

# --- 5. SearXNG Private Search Engine ---
SEARXNG_SECRET=e3a1f89c42b07e5d8a9f0c1b2d3e4f5a

# --- 6. Firecrawl Web Scraper Stack ---
FIRECRAWL_API_KEY=firecrawl_secret_api_key_12345

# --- 7. CPU Thread & Concurrency Tuning (Prevents Thread Starvation on 24 Cores) ---
OMP_NUM_THREADS=12
RAYON_NUM_THREADS=12
WHISPER_CPU_THREADS=8

# --- 8. API Security Keys (Securing AI Inference & Compute Services) ---
OLLAMA_API_KEY=sk-homelab-ollama-secure-key
TEI_API_KEY=sk-homelab-tei-secure-key
SPEACHES_API_KEY=sk-homelab-speaches-secure-key

# --- 9. Firecrawl Internal Database Credentials ---
NUQ_USER=nuq_user
NUQ_PASSWORD=nuq_password
NUQ_DB=nuq_db
